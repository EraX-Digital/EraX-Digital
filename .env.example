# Local development defaults. Run `node scripts/write-dev-env.mjs` to create `.env`
# with a generated session secret. Do not commit `.env`.
#
# Docker Compose publishes PostgreSQL and Valkey with the local-only password below.
# Those values are for a developer machine. Production must replace them.

NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=4000
API_PUBLIC_ORIGIN=http://127.0.0.1:4000
INDEXER_HOST=127.0.0.1
INDEXER_PORT=4001

# postgres uses Docker or a local PostgreSQL 16 server.
# pglite is an embedded PostgreSQL-compatible database for machines without Docker.
DATABASE_DRIVER=postgres
DATABASE_URL=postgres://erax:erax_local_dev_only@127.0.0.1:5432/erax
PGLITE_DIR=./var/pglite

# valkey is required when RATE_LIMIT_STORE=valkey.
# memory is allowed only for development and test, and readiness reports Valkey as not connected.
RATE_LIMIT_STORE=valkey
VALKEY_URL=redis://127.0.0.1:6379

WEB_ORIGIN=http://127.0.0.1:3000
ADMIN_ORIGIN=http://127.0.0.1:3001
SESSION_COOKIE_SECRET=
SESSION_TTL_SECONDS=604800
COOKIE_SECURE=false

# outbox stores messages on disk and does not send email.
# smtp delivers through the configured server. Mailpit is included in Docker Compose on port 1025.
EMAIL_MODE=outbox
EMAIL_OUTBOX_DIR=./var/outbox
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_FROM=EraX <no-reply@localhost>
SMTP_USER=
SMTP_PASSWORD=

MEDIA_ROOT=./var/media
ENABLE_API_DOCS=true

# Used only by `pnpm db:seed`. Never hardcode these in source.
DEV_ADMIN_EMAIL=
DEV_ADMIN_PASSWORD=
