# EraX environment inventory. Values below are placeholders.
# `node scripts/write-dev-env.mjs` writes a local `.env` with a generated session secret.
# Do not commit `.env`. Do not put secrets in NEXT_PUBLIC_ variables.

# -----------------------------------------------------------------------------
# Frontend public variables
# Inlined into the browser by Next.js at build time. Safe to expose.
# Set these on the Vercel projects for apps/web and apps/admin.
# Local development already sets them in apps/web/.env.development and
# apps/admin/.env.development.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://127.0.0.1:4000

# -----------------------------------------------------------------------------
# Process
# -----------------------------------------------------------------------------
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=4000
API_PUBLIC_ORIGIN=http://127.0.0.1:4000
INDEXER_HOST=127.0.0.1
INDEXER_PORT=4001
TRUST_PROXY=false
ENABLE_API_DOCS=true

# -----------------------------------------------------------------------------
# Database
# Runtime uses DATABASE_URL. Migrations use DATABASE_MIGRATION_URL when set,
# otherwise DATABASE_URL. Neon: put the pooled URL in DATABASE_URL and the
# direct URL in DATABASE_MIGRATION_URL. Production requires DATABASE_SSL=require.
# PGlite is development-only and is rejected when NODE_ENV=production.
# -----------------------------------------------------------------------------
DATABASE_DRIVER=postgres
DATABASE_URL=postgres://erax:erax_local_dev_only@127.0.0.1:5432/erax
DATABASE_MIGRATION_URL=
DATABASE_POOL_MAX=10
DATABASE_SSL=disable
PGLITE_DIR=./var/pglite
ERAX_AUTO_MIGRATE=true

# -----------------------------------------------------------------------------
# Cache
# Production requires Valkey (Redis protocol). memory is development-only.
# -----------------------------------------------------------------------------
RATE_LIMIT_STORE=valkey
VALKEY_URL=redis://127.0.0.1:6379

# -----------------------------------------------------------------------------
# Authentication
# SESSION_COOKIE_SECRET is a server-only signing secret. Generate at least 32
# characters. COOKIE_DOMAIN is empty on localhost. Production on separate
# subdomains uses the parent domain, for example .erax.digital.
# The session cookie stays on the API host. The CSRF cookie uses COOKIE_DOMAIN.
# -----------------------------------------------------------------------------
WEB_ORIGIN=http://127.0.0.1:3000
ADMIN_ORIGIN=http://127.0.0.1:3001
SESSION_COOKIE_SECRET=
SESSION_TTL_SECONDS=604800
COOKIE_SECURE=false
COOKIE_DOMAIN=

# -----------------------------------------------------------------------------
# Email provider
# outbox writes files under EMAIL_OUTBOX_DIR and does not send mail.
# Production requires EMAIL_MODE=smtp. SMTP delivery has not been exercised
# against a real provider in this repository.
# -----------------------------------------------------------------------------
EMAIL_MODE=outbox
EMAIL_OUTBOX_DIR=./var/outbox
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_FROM=EraX <no-reply@localhost>
SMTP_USER=
SMTP_PASSWORD=

# -----------------------------------------------------------------------------
# Media storage
# filesystem is the local development disk. Production requires s3.
# S3_ENDPOINT is the S3-compatible API, including Cloudflare R2 or AWS S3.
# -----------------------------------------------------------------------------
MEDIA_DRIVER=filesystem
MEDIA_ROOT=./var/media
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# -----------------------------------------------------------------------------
# Development seed
# Used only by `pnpm db:seed`. The command refuses NODE_ENV=production and
# refuses any non-local database host. It creates one development administrator.
# -----------------------------------------------------------------------------
DEV_ADMIN_EMAIL=
DEV_ADMIN_PASSWORD=

# -----------------------------------------------------------------------------
# Blockchain RPC configuration
# Backend secrets. Leave empty in production until you choose a provider.
# Development falls back to keyless public endpoints. Test and production do not.
# Never put these URLs in NEXT_PUBLIC_ variables when they contain an API key.
# -----------------------------------------------------------------------------
EVM_RPC_URL_1=
EVM_RPC_URL_8453=
EVM_RPC_URL_11155111=
EVM_RPC_URL_84532=
# Optional. Used only by forge verify-contract. Leave empty. Never commit a filled-in key.
ETHERSCAN_API_KEY=
BASESCAN_API_KEY=
SOLANA_RPC_URL_MAINNET=
SOLANA_RPC_URL_DEVNET=
TRUSTED_TOKEN_LIST_JSON=

# Frontend-public. WalletConnect is omitted when this is empty.
# A project id is not a server secret, but it is visible in the browser.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Frontend-public Solana cluster URLs used only to broadcast a wallet-signed
# transaction. Leave empty to use the keyless public cluster endpoints.
# Do not put an API key in these variables. They are visible in the browser.
NEXT_PUBLIC_SOLANA_RPC_URL_DEVNET=
NEXT_PUBLIC_SOLANA_RPC_URL_MAINNET=
